# Copy to .env for local configuration. Never commit real credentials.
DATABASE_URL=
# Comma-separated exact frontend origins. For Render, set this to your static site's https://...onrender.com origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://127.0.0.1:8000
# Optional OpenAI-compatible classification provider. If unset, local mock is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
SHOPSENSE_TICKET_MAX_CHARACTERS=20000
SHOPSENSE_TICKET_MAX_TOKENS=512
SHOPSENSE_TICKET_MAX_PROMPT_TOKENS=8192
SHOPSENSE_TICKET_CLASSIFICATION_METHOD=zero_shot
# Phase 6 policy RAG; local hash embeddings and SQLite vector fallback work without keys.
RAG_POLICY_DIR=policies
RAG_INDEX_DIR=outputs/chroma
RAG_VECTOR_BACKEND=auto
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=4
RAG_EMBEDDING_PROVIDER=local-hash
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
RAG_CONVERSATION_DB=outputs/assistant/conversations.sqlite3
RAG_MINIMUM_SIMILARITY=0.05
